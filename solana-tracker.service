[Unit]
Description=Solana Micro-Cap Holder Accumulation Research Engine
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/solana-holder-scanner
ExecStart=/opt/solana-holder-scanner/venv/bin/python -m uvicorn backend.app:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
